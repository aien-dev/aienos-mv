fn emem v uint to uint
ret add mul and shr v uint 8 uint 255 uint 64 and shr v uint 2 uint 63
end
fn ready kind uint to bool
if eq kind uint 0
head = rd uint 8653824
tail = rd uint 8653828
ret eq head tail
end
if eq kind uint 1
put Meta 7 rd uint 8650816
ret ne get Meta 7 uint 3221342974
end
if eq kind uint 2
put Meta 9 rd uint 1114356
ret and ne get Meta 9 uint 0 ne and get Meta 9 uint 4294967040 uint 3135193344
end
put Meta 10 rd uint 1114176
if and ne get Meta 10 uint 0 eq get Meta 10 get Config 2
put Meta 11 rd uint 1114180
if eq get Meta 11 get Config 3
ret false
end
end
put Meta 9 rd uint 1114356
ret or eq and get Meta 9 uint 8192 uint 0 ne get Meta 10 uint 0
end
fn waitfor kind uint to int
n = uint 0
budget = get Config add 5 ulong kind
while true
ok = ready kind
put Meta add 1 ulong kind n
if ne get State 3 uint 0
ret int get State 3
end
if ok
ret 0
end
if ge n budget
if eq kind uint 1
put Meta 8 rd uint 8650820
end
if eq kind uint 3
put Meta 11 rd uint 1114180
end
if eq kind uint 0
ret 2
end
ret int add kind uint 3
end
if ne get Config 9 uint 0
put State 2 add get State 2 uint 1
end
n = add n uint 1
end
ret 1
end
fn packword i ulong to uint
v = uint 0
for k ulong 4
if lt add i k ulong get Config 0
v = or v shl uint get In add 44 add i k mul uint k 8
end
end
ret v
end
fn upload to int
wr uint 8653504 uint 16777216
start = emem rd uint 8653504
size = ulong get Config 0
i = ulong 0
count = uint 0
while lt i size
wr uint 8653508 packword i
count = add count uint 1
i = add i 4
end
put Meta 5 count
put Meta 6 rd uint 8653504
if ne sub emem get Meta 6 start count
ret 3
end
wr uint 8653828 sub mul count uint 4 uint 4
wr uint 8653824 uint 0
ret 0
end
fn boot to int
if or eq get Config 0 uint 0 gt get Config 0 uint 1024
ret 1
end
status = waitfor uint 0
if ne status 0
ret status
end
status = upload
if ne status 0
ret status
end
for kind uint 3
status = waitfor add kind uint 1
if ne status 0
ret status
end
end
put Meta 10 rd uint 1114176
if ne get Meta 10 uint 0
ret 7
end
wr uint 1114240 get Config 4
put Meta 12 rd uint 1119112
if eq and get Meta 12 uint 128 uint 0
ret 8
end
ret 0
end
