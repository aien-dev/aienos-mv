note Native courier lifecycle regression. Clock values are injected milliseconds.
text Lineone "SAY 1 1/1 Model text."
note check writes through Outb; preserve the actual pending datagram around logging.
global SavedOut uchar 8192
fn test ok bool to void
n = get Outlen 0
e = get Err 0
for i ulong n
put SavedOut i get Outb i
end
check ok add get Checks 0 1
for i ulong n
put Outb i get SavedOut i
end
put Outlen 0 n
put Err 0 e
end
fn tcopy to void
put Inlen 0 get Outlen 0
for i ulong get Outlen 0
put In i get Outb i
end
end
fn control kind ulong seq ulong to void
put Inlen 0 0
b = packet kind seq 0 0 0
tcopy
end
fn linepkt part ulong to void
put Inlen 0 len Lineone
for i ulong len Lineone
put In i get Lineone i
end
b = packet 2 get Q 1 part 0 0
tcopy
end
fn jobinput to void
put Inlen 0 1001
for i ulong 1001
put In i 120
end
put In 999 10
put In 1000 121
end
fn main to int
test qstart 42 100
test not qready 100
test not qnext 100 false
test eq get T 3 0
test qnext 100 true
test eq get T 10 5
test not qnext 100 true
test qsent 100 false
test eq get T 3 0
test qnext 101 true
test qsent 101 true
test eq get T 3 1
test not qnext 2100 true
test qnext 2101 true
test qsent 2101 true
control 6 0
test eq qincoming 2102 1
test qready 2102
test not qnext 12100 true
test qnext 12101 true
test eq get T 10 5
test qsent 12101 true
test qready 32101
test not qready 32102
test qnext 32102 true
test qsent 32102 true
test not qnext 32101 true
test eq get T 0 32102
jobinput
test qsubmit 32103
test eq get Q 1 1
test eq get JobOut 999 32
test eq get JobOut 1000 121
test not qsubmit 32103
test qnext 32103 true
test eq get T 10 1
test eq get T 11 1
tcopy
test pkparse
test eq get N 6 1000
test eq get In add get N 5 999 32
test qsent 32103 false
test eq get T 9 1
test qnext 32104 true
test eq get T 11 1
test qsent 32104 true
test qnext 32104 true
test eq get T 11 2
tcopy
test pkparse
test eq get N 6 1
test eq get In get N 5 121
test qsent 32104 true
test eq get T 9 0
control 6 0
test eq qincoming 32105 1
test qready 32105
test not qnext 34103 true
