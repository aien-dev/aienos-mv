test eq get T 11 1
test qsent 34104 true
test qnext 34104 true
test eq get T 11 2
test qsent 34104 true
control 4 2
test eq qincoming 34105 0
test eq get T 6 0
control 4 1
test eq qincoming 34105 1
test eq get T 6 1
test not qnext 36104 true
linepkt 1
test eq qincoming 36105 1
test eq get Q 4 1
test eq get T 13 1
test qnext 36105 true
test eq get T 10 3
test qsent 36105 false
test eq get T 13 1
linepkt 1
test eq qincoming 36106 2
test eq get Q 4 1
test qnext 36106 true
test eq get T 10 3
test qsent 36106 true
test eq get T 13 0
test qtake
test eq get Inlen 0 len Lineone
test not qtake
linepkt 2
test eq qincoming 36107 1
linepkt 3
test eq qincoming 36107 0
test eq get Q 2 2
test eq get Q 4 1
test qnext 36108 true
test qsent 36108 true
linepkt 3
test eq qincoming 36109 1
