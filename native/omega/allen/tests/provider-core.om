hword 24 arg
hword 32 size
end
fn oword off ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get Pout add off i mul i 8
end
ret v
end
fn receive part ulong size ulong to void
note Caller placed LINE payload in In; packet overwrites Outb, so preserve it.
n = get Outlen 0
e = get Err 0
for i ulong n
put Held i get Outb i
end
put Inlen 0 size
b = packet 2 get Q 1 part 0 0
size = get Outlen 0
for i ulong size
put Pb i get Outb i
end
for i ulong n
put Outb i get Held i
end
put Outlen 0 n
put Err 0 e
frame 5 4294967297 0 size
end
