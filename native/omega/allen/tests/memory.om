fn enctounit to void
for i ulong 4096
put Unit i get Enc i
end
end
fn diskput slot ulong count ulong to void
for i ulong count
put Disk add mul slot 4096 i get Enc i
end
end
fn diskget slot ulong to void
for i ulong 4096
put Unit i get Disk add mul slot 4096 i
end
end
