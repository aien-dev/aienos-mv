note Handwritten stream interface around the pinned native Omega SHA256 core.
fn main to int
constants
hinit
total = ulong 0
n = read 0 Buf 0 len Buf
while gt n 0
if gt ulong n sub ulong 8388608 total
ret 3
end
update 0 ulong n
total = add total ulong n
n = read 0 Buf 0 len Buf
end
if lt n 0
ret 2
end
finish
for i ulong 32
c = get Hash i
put Out mul i 2 get Hex ulong shr c 4
put Out add mul i 2 1 get Hex ulong and c 15
end
put Out 64 uchar 10
sent = ulong 0
while lt sent 65
w = write 1 Out sent sub ulong 65 sent
if le w 0
ret 2
end
sent = add sent ulong w
end
ret 0
end
