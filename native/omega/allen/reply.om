note SAY/WAIT parser, staged folded bytes. Native CODE receive remains separate.
global Say uchar 160
global S ulong 5
fn sayhead to bool
put P 0 0
put P 2 0
if ineq 0 87
expect 87
expect 65
expect 73
expect 84
expect 32
number
put S 0 get P 1
put S 1 0
put S 2 0
if ne get P 0 get Inlen 0
ret false
end
ret eq get P 2 0
end
expect 83
expect 65
expect 89
expect 32
number
put S 0 get P 1
expect 32
if ne get P 2 0
