if ne codestat 2
if eq get R 13 0
put R 13 1
outreset
emitb 65
emitb 71
emitb 65
emitb 73
emitb 78
emitb 32
emitn get R 0
ret 2
end
cancel
ret 3
end
else
if ne get S 1 add get R 11 1
ret 0
end
if and ne get S 2 0 ne get S 2 get S 1
ret 0
end
end
n = get R 8
if or eq get S 1 1 gt get R 2 1
n = 0
end
join = ulong 0
if and gt n 0 gt get S 4 0
join = 1
end
if gt add add n join get S 4 159
ret 0
end
if gt get R 2 1
if not codeshow get R 0
ret 0
end
end
