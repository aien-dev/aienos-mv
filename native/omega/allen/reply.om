fn sayfold to bool
n = ulong 0
p = get S 3
space = true
while lt p get Inlen 0
c = get In p
p = add p 1
if eq c 92
if or ineq p 110 ineq p 116
c = 32
p = add p 1
end
end
if or lt c 32 ge c 127
c = 32
end
if eq c 32
if not space
if ge n 159
ret false
end
put Say n c
n = add n 1
end
space = true
else
if ge n 159
ret false
end
put Say n c
n = add n 1
space = false
end
end
if gt n 0
if eq get Say sub n 1 32
n = sub n 1
end
end
put S 4 n
ret true
end
note Return1 accepted,2 request AGAIN,3 give up after retry;0 rejected.
fn saytake now ulong to ulong
if or eq get R 1 0 gt get Inlen 0 319
ret 0
end
if not sayhead
ret 0
end
if or ne get S 0 get R 0 lt now get R 4
ret 0
end
if eq get S 1 0
b = heard get S 0 now
ret 1
end
if not sayfold
ret 0
end
if gt get R 2 1
if eq get S 2 0
ret 0
end
if ne get C 0 get R 0
ret 0
