note L694 fixed-buffer utilities. No platform effects in product functions.
global In uchar 8192
global Inlen ulong 1
global Outb uchar 8192
global Outlen ulong 1
global Err ulong 1
text Digits "0123456789abcdef"
fn emitb c uchar to void
n = get Outlen 0
if ge n len Outb
put Err 0 1
else
put Outb n c
put Outlen 0 add n 1
end
end
fn emitn v ulong to void
d = new uchar 20 0
n = ulong 0
x = v
put d n uchar add rem x 10 48
n = add n 1
x = div x 10
while gt x 0
put d n uchar add rem x 10 48
n = add n 1
x = div x 10
end
while gt n 0
n = sub n 1
emitb get d n
end
end
fn outreset to void
put Outlen 0 0
put Err 0 0
end
fn ineq at ulong c uchar to bool
if ge at get Inlen 0
ret false
end
ret eq get In at c
end
fn isdigit c uchar to bool
ret and ge c 48 le c 57
end
note Parser cursor P0, number P1, error P2. Never wraps a u32.
global P ulong 3
fn number to void
v = ulong 0
n = ulong 0
p = get P 0
while lt p get Inlen 0
c = get In p
if not isdigit c
put P 0 p
put P 1 v
if eq n 0
put P 2 1
end
ret
end
if or ge n 10 gt v 429496729
put P 2 1
ret
end
v = add mul v 10 sub ulong c 48
if gt v 4294967295
put P 2 1
ret
end
n = add n 1
p = add p 1
end
put P 0 p
put P 1 v
if eq n 0
put P 2 1
end
end
fn expect c uchar to void
p = get P 0
if not ineq p c
put P 2 1
else
put P 0 add p 1
end
end
fn crc off ulong count ulong to uint
c = uint 4294967295
for i ulong count
c = xor c uint get In add off i
for k ulong 8
if ne and c 1 0
c = xor shr c 1 3988292384
else
c = shr c 1
end
end
end
ret not c
end
