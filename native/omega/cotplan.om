note Handwritten SEC2 COT serialization into a BTS1 lab frame. No device access.
note CTP1 fixed908 bytes; output BTS1 fixed948 bytes, packet868 at offset44.
global In uchar 909
global Out uchar 948
fn raw pos ulong to uint
v = uint 0
for j ulong 4
v = or v shl uint get In add pos j mul uint j 8
end
ret v
end
fn word pos ulong v uint to void
for j ulong 4
put Out add pos j uchar and shr v mul uint j 8 uint 255
end
end
fn copy src ulong dst ulong count ulong to void
for i ulong count
put Out add dst i get In add src i
end
end
fn decode used ulong to int
if ne used 908
ret 2
end
if ne raw 0 uint 827348035
ret 2
end
if or ne raw 4 uint 868 ne raw 8 uint 0
ret 2
end
if eq raw 52 uint 0
ret 2
end
for i ulong 4
if gt raw add 24 mul i 4 uint 128
ret 2
end
end
if or gt raw 40 uint 1 or gt raw 896 uint 1 gt raw 900 uint 1
ret 2
end
word 0 uint 827544642
copy 4 4 40
word 44 uint 3221225472
word 48 uint 336649854
word 52 uint 56360961
copy 44 56 8
copy 52 72 4
copy 56 88 816
copy 12 904 8
copy 872 912 36
sent = ulong 0
while lt sent len Out
r = write 1 Out sent sub len Out sent
if le r 0
ret 2
end
sent = add sent ulong r
end
ret 0
end
fn main to int
used = ulong 0
while lt used len In
r = read 0 In used sub len In used
if lt r 0
ret 2
end
if eq r 0
ret decode used
end
used = add used ulong r
end
ret 2
end
