note Offline mirror of pinned aien-gpu register permission and doorbell policy.
note RGP1 input: boot,latch,count then op,offset pairs; op0 read op1 write.
note Output: final latch,count then positive errno decisions. No hardware access.
global In uchar 2065
global Out uchar 1032
global R uint 13
global W uint 6
global C uint 3
fn init to void
put R 0 uint 0
put R 1 uint 2560
put R 2 uint 8650816
put R 3 uint 8650820
put R 4 uint 8653504
put R 5 uint 8653824
put R 6 uint 8653828
put R 7 uint 1114176
put R 8 uint 1114180
put R 9 uint 1114240
put R 10 uint 1114356
put R 11 uint 1117184
put R 12 uint 1119112
put W 0 uint 8653504
put W 1 uint 8653508
put W 2 uint 8653824
put W 3 uint 8653828
put W 4 uint 1114240
put W 5 uint 1117184
end
fn word pos ulong to uint
v = uint 0
for j ulong 4
v = or v shl uint get In add pos j mul uint j 8
end
ret v
end
fn pack pos ulong v uint to void
for j ulong 4
put Out add pos j uchar and shr v mul uint j 8 uint 255
end
end
fn canread off uint to bool
for i ulong len R
if eq off get R i
ret true
end
end
ret false
end
fn canwrite off uint to bool
for i ulong len W
if eq off get W i
ret true
end
end
ret false
end
fn allow op uint off uint to uint
if eq op uint 0
if canread off
ret uint 0
end
ret uint 1
end
if ne op uint 1
ret uint 25
end
if or eq get C 0 uint 0 not canwrite off
ret uint 1
end
if eq off uint 8653824
if ne get C 1 uint 0
ret uint 114
end
put C 1 uint 1
end
ret uint 0
end
fn run n ulong to int
if or lt n 16 ne rem n 4 0
ret 2
end
if ne word 0 uint 827344722
ret 2
end
for i ulong 3
put C i word add 4 mul i 4
end
count = ulong get C 2
if or gt count 256 ne n add 16 mul count 8
ret 2
end
if gt get C 0 uint 1
ret 2
end
init
for i ulong count
pos = add 16 mul i 8
v = allow word pos word add pos 4
pack add 8 mul i 4 v
end
pack 0 get C 1
pack 4 uint count
size = add 8 mul count 4
sent = ulong 0
while lt sent size
r = write 1 Out sent sub size sent
if le r 0
ret 2
end
sent = add sent ulong r
end
ret 0
end
fn main to int
used = ulong 0
while lt used len In
r = read 0 In used sub len In used
if lt r 0
ret 2
end
if eq r 0
ret run used
end
used = add used ulong r
end
ret 2
end
