note Host-native behavioral reconstruction of raw GSP routine offset 0x28.
note Input records: a,n,b,m as four u64 little-endian; output u64 0 or 1.
note Bounded stream: 4096 batches of 512 records; completed records retain output.
note Short final record exit2; IO exit3; any extra input after capacity exit4.
note No GPU interface. This is NOT GSP firmware or a RISC-V artifact.
global req uchar 32
global out uchar 8

fn ranges a ulong n ulong b ulong m ulong to ulong
if or eq n 0 eq m 0
ret 0
end
if gt n sub ulong 18446744073709551615 a
ret 1
end
if gt m sub ulong 18446744073709551615 b
ret 1
end
if and lt a add b m lt b add a n
ret 1
end
ret 0
end

fn word off ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get req add off i mul i 8
end
ret v
end

fn fill to long
used = ulong 0
while lt used 32
n = read 0 req used sub ulong 32 used
if lt n 0
ret long -1
end
if eq n 0
ret long used
end
used = add used ulong n
end
ret long used
end

fn send v ulong to int
for i ulong 8
put out i uchar and shr v mul i 8 255
end
sent = ulong 0
while lt sent 8
n = write 1 out sent sub ulong 8 sent
if le n 0
ret 3
end
sent = add sent ulong n
end
ret 0
end

fn main to int
for batch ulong 4096
for slot ulong 512
n = fill
if lt n 0
ret 3
end
if eq n 0
ret 0
end
if ne n 32
ret 2
end
value = ranges word 0 word 8 word 16 word 24
status = send value
if ne status 0
ret status
end
end
end
more = fill
if lt more 0
ret 3
end
if eq more 0
ret 0
end
ret 4
end
