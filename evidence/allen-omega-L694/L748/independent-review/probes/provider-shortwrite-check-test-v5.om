ret false
end
if not qsent now ok
ret false
end
put A 2 0
ret true
end
fn appbody now ulong to bool
if eq get R 1 0
put A 2 4
ret true
end
if ineq 0 67
if or le get R 2 1 ne get C 0 get R 0
put A 2 4
ret true
end
if codetake
if heard get C 0 now
ret true
end
end
put A 2 4
ret true
end
