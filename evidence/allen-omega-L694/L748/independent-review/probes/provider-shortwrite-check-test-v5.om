put K 26 2952996808
put K 27 3210313671
put K 28 3336571891
put K 29 3584528711
put K 30 113926993
put K 31 338241895
put K 32 666307205
put K 33 773529912
put K 34 1294757372
put K 35 1396182291
put K 36 1695183700
put K 37 1986661051
