end
fn prapply to ulong
op = get Pv 0
now = get Pv 1
arg = get Pv 2
if eq op 10
ret prload
end
if eq op 8
ret prcopy
end
if eq op 9
ret prnote
end
if eq op 1
if or eq get Pc 0 1 eq get Pc 0 2
ret 0
end
if appinit arg now
ret 1
end
ret 0
end
if eq get A 0 0
ret 0
end
if eq op 6
appcancel
ret 1
end
if eq op 7
appreset
ret 1
end
if not appclock now
ret 0
end
if eq op 3
offer = apppoll now ne arg 0
prevent
if offer
put Pe 1 1
ret 3
end
ret 1
end
if eq op 4
if appsent now ne arg 0
ret 1
end
ret 0
end
for i ulong get Pv 3
put In i get Pb i
end
put Inlen 0 get Pv 3
if eq op 2
if not appask now
ret 0
end
else
if not appreceive now
ret 0
end
end
prevent
ret 1
end
fn prdo to bool
if not prparse
ret false
end
put Pe 0 0
put Pe 1 0
status = prapply
prreply status
ret true
end
global Fails ulong 1
global Checks ulong 1
fn check ok bool id ulong to void
put Checks 0 add get Checks 0 1
outreset
emitn id
if ok
emitb 32
emitb 48
else
put Fails 0 add get Fails 0 1
emitb 32
emitb 49
end
emitb 10
w = write 1 Outb 0 get Outlen 0
end
global Receipt uchar 4096
global V ulong 4
global Pos ulong 1
global Sstart ulong 1
text Mag "ALNPRV01"
fn checknum ok bool to void
check ok add get Checks 0 1
end
fn parsenum n ulong to bool
v = ulong 0
digits = ulong 0
while lt get Pos 0 n
c = get Receipt get Pos 0
put Pos 0 add get Pos 0 1
if eq c 10
if eq digits 0
ret false
end
put V get Sstart 0 v
put Sstart 0 add get Sstart 0 1
ret true
end
if or lt c 48 gt c 57
ret false
end
v = add mul v 10 sub ulong c 48
digits = add digits 1
end
ret false
end
fn sbyte p ulong c uchar to void
checknum eq get Receipt p c
end
fn shead p ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get Receipt add p i mul i 8
end
ret v
end
fn main to int
n = ulong 0
while lt n 1036
r = read 0 Receipt n sub len Receipt n
if le r 0
ret 65
end
n = add n ulong r
end
for i ulong 4
if not parsenum n
ret 65
end
end
checknum eq get V 0 8
checknum eq get V 1 74
checknum eq get V 2 1024
checknum eq get V 3 0
p = get Pos 0
checknum eq n add p 1024
for rec ulong 7
for i ulong 8
sbyte add p i get Mag i
end
size = shead add p 32
checknum le size 8192
p = add add p 40 size
end
checknum eq p add get Pos 0 923
remain = sub n p
checknum eq remain 101
for i ulong 8
sbyte add p i get Mag i
end
checknum eq shead add p 8 3
checknum eq shead add p 16 3
checknum eq shead add p 24 0
checknum eq shead add p 32 71
checknum eq get Checks 0 83
if ne get Fails 0 0
ret 1
end
ret 0
end
