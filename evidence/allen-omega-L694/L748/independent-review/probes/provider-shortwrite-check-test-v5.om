note L694 fixed-buffer utilities. No platform effects in product functions.
global In uchar 8192
global Inlen ulong 1
global Outb uchar 8192
global Outlen ulong 1
global Err ulong 1
text Digits "0123456789abcdef"
fn emitb c uchar to void
n = get Outlen 0
if ge n len Outb
put Err 0 1
else
put Outb n c
put Outlen 0 add n 1
end
end
fn emitn v ulong to void
d = new uchar 20 0
n = ulong 0
x = v
put d n uchar add rem x 10 48
n = add n 1
x = div x 10
while gt x 0
put d n uchar add rem x 10 48
n = add n 1
x = div x 10
end
while gt n 0
n = sub n 1
emitb get d n
end
end
fn outreset to void
put Outlen 0 0
put Err 0 0
end
fn ineq at ulong c uchar to bool
if ge at get Inlen 0
ret false
end
ret eq get In at c
end
fn isdigit c uchar to bool
ret and ge c 48 le c 57
end
note Parser cursor P0, number P1, error P2. Never wraps a u32.
global P ulong 3
fn number to void
v = ulong 0
n = ulong 0
p = get P 0
while lt p get Inlen 0
c = get In p
if not isdigit c
put P 0 p
put P 1 v
if eq n 0
put P 2 1
end
ret
end
if or ge n 10 gt v 429496729
put P 2 1
ret
end
v = add mul v 10 sub ulong c 48
if gt v 4294967295
put P 2 1
ret
end
n = add n 1
p = add p 1
end
put P 0 p
put P 1 v
if eq n 0
put P 2 1
end
end
fn expect c uchar to void
p = get P 0
if not ineq p c
put P 2 1
else
put P 0 add p 1
end
end
fn crc off ulong count ulong to uint
c = uint 4294967295
for i ulong count
c = xor c uint get In add off i
for k ulong 8
if ne and c 1 0
c = xor shr c 1 3988292384
else
c = shr c 1
end
end
end
ret not c
end
note SPDX-License-Identifier: AGPL-3.0-or-later
note SHA256 core reused byte-for-byte from native Omega TRN1 at 12251e3403d42931ada27dc1c54b3b610954be5d.
note Reads stdin up to 8 MiB and emits lowercase hex plus LF only after successful EOF.
global Buf uchar 8192
global H uint 8
global Vv uint 8
global W uint 64
global K uint 64
global Hb uchar 64
global Hs ulong 2
global Hash uchar 32
global Out uchar 65
text Hex "0123456789abcdef"

fn rotate x uint n uint to uint
ret or shr x n shl x sub 32 n
end

fn round i ulong to void
e = get Vv 4
a = get Vv 0
s = xor xor rotate e 6 rotate e 11 rotate e 25
c = xor and e get Vv 5 and not e get Vv 6
t = add add get Vv 7 s add c add get K i get W i
s = xor xor rotate a 2 rotate a 13 rotate a 22
c = and a get Vv 1
c = xor c and a get Vv 2
c = xor c and get Vv 1 get Vv 2
u = add s c
put Vv 7 get Vv 6
put Vv 6 get Vv 5
put Vv 5 e
put Vv 4 add get Vv 3 t
put Vv 3 get Vv 2
put Vv 2 get Vv 1
put Vv 1 a
put Vv 0 add t u
end

fn block to void
for i ulong 16
x = uint 0
for j ulong 4
x = or shl x 8 uint get Hb add mul i 4 j
end
put W i x
end
for j ulong 48
i = add j 16
x = get W sub i 15
y = get W sub i 2
s = xor xor rotate x 7 rotate x 18 shr x 3
t = xor xor rotate y 17 rotate y 19 shr y 10
put W i add add get W sub i 16 s add get W sub i 7 t
end
for i ulong 8
put Vv i get H i
end
for i ulong 64
round i
end
for i ulong 8
put H i add get H i get Vv i
end
end

fn hinit to void
put H 0 1779033703
put H 1 3144134277
put H 2 1013904242
put H 3 2773480762
put H 4 1359893119
put H 5 2600822924
put H 6 528734635
put H 7 1541459225
put Hs 0 0
put Hs 1 0
end

fn hbyte c uchar to void
p = get Hs 0
put Hb p c
p = add p 1
put Hs 1 add get Hs 1 1
if eq p 64
block
p = 0
end
put Hs 0 p
end

fn update off ulong count ulong to void
for i ulong count
hbyte get Buf add off i
end
end

fn finish to void
bits = mul get Hs 1 8
hbyte 128
while ne get Hs 0 56
hbyte 0
end
for i ulong 8
hbyte uchar and shr bits mul sub 7 i 8 255
end
for i ulong 32
x = get H div i 4
put Hash i uchar and shr x uint mul sub 3 rem i 4 8 255
end
end

fn constants to void
put K 0 1116352408
put K 1 1899447441
put K 2 3049323471
put K 3 3921009573
