note Independent signed fractional and clip-edge probes, handwritten Omega.
global Fails ulong 1
global Checks ulong 1
fn check ok bool id ulong to void
put Checks 0 add get Checks 0 1
outreset
emitn id
if ok
emitb 32
emitb 48
else
put Fails 0 add get Fails 0 1
emitb 32
emitb 49
end
emitb 10
w = write 1 Outb 0 get Outlen 0
end
fn main to int
b = afinit 14 900
b = cvinit 4 4
check b 1
check cvclip 1 0 2 4 2
cvkeep
cvpixel -1 1 255 16711680
cvpixel 3 1 255 16711680
check cvsame 3
cvpixel 1 1 0 16711680
check cvsame 4
cvpixel 1 1 255 16711680
check eq get Canvas 15 255 5
check eq get Canvas 16 0 6
check eq get Canvas 17 0 7
cvkeep
check not cvclip 3 0 2 1 8
check cvsame 9
put Dtext 0 65
put Dtext 1 65
put Dtext 2 65
b = cvinit 8 4
check b 10
check cvclip 0 0 8 4 11
b = cvspan 0 3 -1 3 15528188
check b 12
advance = get Cv 7
for i ulong 24
put Csave i get Canvas i
end
b = cvinit 8 4
check b 13
for i ulong 3
x = affloor add long -256 long mul advance i
check cvglyph 65 x 3 15528188 add i 14
end
same = true
for i ulong 96
if ne get Canvas i get Csave i
same = false
end
end
check same 17
check eq get Cv 7 mul advance 3 18
if ne get Fails 0 0
ret 1
end
ret 0
end
