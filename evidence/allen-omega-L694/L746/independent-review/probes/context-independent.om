same = true
for i ulong len Plural
if ne get Meta i get Plural i
same = false
end
end
test same
put Mem 40 9
test not ctxmeta 6
test not ctxappend
put Mem 40 103
for i ulong 48
put Mem add i 40 107
end
test not ctxmeta 6
note Thirty-two full facts and six full notes overflow metadata itself, not only JOB.
for i ulong 3692
put Mem i 0
end
mset32 32 32
mset32 36 6
for k ulong 32
off = add 40 mul k 113
for i ulong 47
put Mem add off i 107
end
for i ulong 63
put Mem add add off 48 i 118
end
end
test ctxbegin
