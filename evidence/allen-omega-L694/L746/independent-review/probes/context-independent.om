test eq get Ctxgone 1 1
fixture 2 0
put Unit 64 33
test eq ctxtake 2 2
test eq get Cx 3 1
test eq get Ctxgone 2 1
test not ctxmeta 6
fixture 0 0
test eq ctxtake 0 1
test eq get Cx 1 4
test eq get Cx 2 1
test eq get Cx 4 0
test eq ctxtake 4 0
test ctxmeta 6
test eq get Mx 0 len MetaWant
same = true
for i ulong len MetaWant
if ne get Meta i get MetaWant i
same = false
end
end
test same
test ctxmeta 1
test eq get Mx 0 len NewOnly
same = true
for i ulong len NewOnly
if ne get Meta i get NewOnly i
same = false
end
end
test same
test not ctxmeta 513
test not ctxappend
test ctxmeta 6
outreset
emitb 120
test ctxappend
test eq get Outlen 0 add 1 len MetaWant
test eq get Outb 0 120
