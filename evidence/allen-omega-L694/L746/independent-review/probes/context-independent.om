text Who "Drake"
text Selfname "Allen"
text Fkey "gate code"
text Fval "4471"
text Note0 "Meet at noon."
text Note1 "Old private note."
text Note3 "Bring tools."
text MetaWant "\tself=Allen\tname=Drake\tstarts=7\tfact gate code is 4471\tnote Bring tools.\tnote Meet at noon."
text NewOnly "\tself=Allen\tname=Drake\tstarts=7\tfact gate code is 4471\tnote Bring tools."
text Emptyctx "\tself=Allen\tstarts=0"
text Lastsix "\tself=Allen\tstarts=0\tnote N9\tnote N8\tnote N7\tnote N6\tnote N5\tnote N4"
text Plural "\tself=Allen\tname=Drake\tstarts=4294967295\tfact gate code are 4471"
global Unitsave uchar 8192
global Saveout uchar 8192
global Saveos ulong 2
global Appsave ulong 16
global Joblen ulong 1
global Qsave ulong 2
fn test ok bool to void
put Saveos 0 get Outlen 0
put Saveos 1 get Err 0
for i ulong get Outlen 0
put Saveout i get Outb i
end
check ok add get Checks 0 1
for i ulong get Saveos 0
put Outb i get Saveout i
end
put Outlen 0 get Saveos 0
put Err 0 get Saveos 1
end
fn fixture index ulong gone ulong to void
put Ns 0 len Note0
put Ns 1 index
put Ns 2 7
put Ns 3 gone
for i ulong len Note0
put Note i get Note0 i
end
if eq index 1
put Ns 0 len Note1
for i ulong len Note1
put Note i get Note1 i
end
end
if eq index 3
put Ns 0 len Note3
for i ulong len Note3
put Note i get Note3 i
end
end
test noteenc
for i ulong 4096
put Unit i get Enc i
end
end
fn memsetup to void
for i ulong 3692
put Mem i 0
end
mset32 0 7
mset32 32 1
mset32 36 4
for i ulong len Who
put Mem add i 8 get Who i
end
for i ulong len Fkey
put Mem add i 40 get Fkey i
end
for i ulong len Fval
put Mem add i 88 get Fval i
end
for i ulong len Selfname
put Mem add i 153 get Selfname i
end
end
fn prompt to void
put Inlen 0 2
put In 0 104
put In 1 105
end
fn main to int
test appinit 123 0
test ctxmeta 6
test eq get Mx 0 len Emptyctx
same = true
for i ulong len Emptyctx
if ne get Meta i get Emptyctx i
same = false
end
end
test same
memsetup
test memenc 100
for i ulong 4096
put Unit i get Enc i
end
loadbeg
test loadcopy 0
test eq get St 0 100
test ctxbegin
test eq get Cx 0 4
test eq get Cx 1 0
test eq get Cx 2 0
test not ctxmeta 6
note Independent admission snapshot: incomplete catalog must not consume ids/history/job.
for i ulong 16
put Appsave i get R i
end
put Joblen 0 get T 8
put Qsave 0 get Q 0
put Qsave 1 get Q 1
put Saveos 0 get Outlen 0
put Saveos 1 get Err 0
for i ulong get Saveos 0
put Saveout i get Outb i
end
for i ulong get T 8
put Unitsave i get JobOut i
end
prompt
test not appask 0
test eq get R 0 get Appsave 0
test eq get R 1 get Appsave 1
test eq get R 9 get Appsave 9
test eq get Q 1 get Qsave 1
test eq get Q 0 get Qsave 0
test eq get T 8 get Joblen 0
test eq get Outlen 0 get Saveos 0
test eq get Err 0 get Saveos 1
same = true
for i ulong get Saveos 0
if ne get Outb i get Saveout i
same = false
end
end
test same
same = true
for i ulong get Joblen 0
if ne get JobOut i get Unitsave i
same = false
end
end
test same
appcancel
fixture 3 0
test eq ctxtake 3 1
test eq get Ctxlen 3 len Note3
test eq get Ctxstart 3 7
test eq ctxtake 3 0
