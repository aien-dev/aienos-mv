note USV1 hosted borrowed-stream adapter. Fixed extents are part of this seed compiler ABI.
note Error values: -1 bad handle/rights, -2 invalid range, -3 native syscall failure.
note Handle 1 stdin (fd0) read-only; 2 stdout (fd1) write-only; 3 stderr (fd2) write-only.
fn usread h ulong b edit uchar 4096 off ulong n ulong to long
if ne h 1
ret -1
end
if or gt off 4096 gt n sub 4096 off
ret -2
end
if eq n 0
ret 0
end
r = read 0 b off n
if lt r 0
ret -3
end
ret r
end
fn uswrite h ulong b view uchar 8192 off ulong n ulong to long
fd = int 0
if eq h 2
fd = int 1
else
if eq h 3
fd = int 2
else
ret -1
end
end
if or gt off 8192 gt n sub 8192 off
ret -2
end
if eq n 0
ret 0
end
tmp = new uchar 8192 0
for i ulong n
put tmp i get b add off i
end
r = write fd tmp 0 n
if lt r 0
ret -3
end
ret r
end
note Independent L743 probe: offset semantics and refusal side effects.
fn main to int
b = new uchar 4096 77
outbuf = new uchar 8192 0
r = usread 7 b 0 1
if ne r -1
exit 101
end
if ne get b 0 77
exit 102
end
r = usread 1 b 2 1
if ne r 1
exit 103
end
if ne get b 2 65
exit 104
end
if ne get b 0 77
exit 105
end
r = usread 1 b 4097 0
if ne r -2
exit 106
end
if ne get b 2 65
exit 107
end
r = usread 1 b 1 1
if ne r 1
exit 108
end
if ne get b 1 66
exit 109
end
if ne get b 3 77
exit 110
end
put outbuf 0 88
put outbuf 1 89
put outbuf 2 90
r = uswrite 2 outbuf 1 2
if ne r 2
exit 111
end
r = uswrite 9 outbuf 0 1
if ne r -1
exit 112
end
if ne get outbuf 1 89
exit 113
end
ret 0
end
