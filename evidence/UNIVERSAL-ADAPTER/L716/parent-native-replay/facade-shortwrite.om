note USV1 hosted borrowed-stream adapter. Fixed extents are part of this seed compiler ABI.
note Error values: -1 bad handle/rights, -2 invalid range, -3 native syscall failure.
note Handle 1 stdin (fd0) read-only; 2 stdout (fd1) write-only; 3 stderr (fd2) write-only.
fn usread h ulong b edit uchar 4096 off ulong n ulong to long
if ne h 1
ret -1
end
if or gt off 4096 gt n sub 4096 off
ret -2
end
if eq n 0
ret 0
end
r = read 0 b off n
if lt r 0
ret -3
end
ret r
end
fn uswrite h ulong b view uchar 8192 off ulong n ulong to long
fd = int 0
if eq h 2
fd = int 1
else
if eq h 3
fd = int 2
else
ret -1
end
end
if or gt off 8192 gt n sub 8192 off
ret -2
end
if eq n 0
ret 0
end
tmp = new uchar 8192 0
for i ulong n
put tmp i get b add off i
end
r = write fd tmp 0 n
if lt r 0
ret -3
end
ret r
end
note A full 8192-byte view write must expose positive short progress and later I/O failure.
fn main to int
b = new uchar 8192 0
for i ulong 8192
put b i 65
end
r = uswrite 2 b 0 8192
if le r 0
exit 51
end
if ge r 8192
exit 52
end
s = uswrite 2 b ulong r sub 8192 ulong r
if ne s -3
exit 53
end
ret 0
end
