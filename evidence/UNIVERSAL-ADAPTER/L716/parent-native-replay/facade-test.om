note USV1 hosted borrowed-stream adapter. Fixed extents are part of this seed compiler ABI.
note Error values: -1 bad handle/rights, -2 invalid range, -3 native syscall failure.
note Handle 1 stdin (fd0) read-only; 2 stdout (fd1) write-only; 3 stderr (fd2) write-only.
fn usread h ulong b edit uchar 4096 off ulong n ulong to long
if ne h 1
ret -1
end
if or gt off 4096 gt n sub 4096 off
ret -2
end
if eq n 0
ret 0
end
r = read 0 b off n
if lt r 0
ret -3
end
ret r
end
fn uswrite h ulong b view uchar 8192 off ulong n ulong to long
fd = int 0
if eq h 2
fd = int 1
else
if eq h 3
fd = int 2
else
ret -1
end
end
if or gt off 8192 gt n sub 8192 off
ret -2
end
if eq n 0
ret 0
end
tmp = new uchar 8192 0
for i ulong n
put tmp i get b add off i
end
r = write fd tmp 0 n
if lt r 0
ret -3
end
ret r
end
note USV1 boundary assertions. Test logic is Omega; the runner only composes/executes it.
fn main to int
inbuf = new uchar 4096 0
outbuf = new uchar 8192 0
r = usread 0 inbuf 0 1
if ne r -1
exit 10
end
r = usread 2 inbuf 0 1
if ne r -1
exit 11
end
r = uswrite 1 outbuf 0 1
if ne r -1
exit 12
end
r = usread 1 inbuf 4096 1
if ne r -2
exit 13
end
r = uswrite 2 outbuf 8191 2
if ne r -2
exit 14
end
r = usread 1 inbuf 18446744073709551615 2
if ne r -2
exit 17
end
r = usread 1 inbuf 4096 0
if ne r 0
exit 15
end
r = uswrite 4 outbuf 0 1
if ne r -1
exit 18
end
r = uswrite 2 outbuf 8192 0
if ne r 0
exit 16
end
ret 0
end
