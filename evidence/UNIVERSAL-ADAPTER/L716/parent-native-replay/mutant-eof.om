note Compiled behavioral mutant: reads falsely report EOF without touching stdin.
fn usread h ulong b edit uchar 4096 off ulong n ulong to long
if ne h 1
ret -1
end
if or gt off 4096 gt n sub 4096 off
ret -2
end
ret 0
end
fn uswrite h ulong b view uchar 8192 off ulong n ulong to long
fd = int 0
if eq h 2
fd = int 1
else
if eq h 3
fd = int 2
else
ret -1
end
end
if or gt off 8192 gt n sub 8192 off
ret -2
end
if eq n 0
ret 0
end
r = write fd b off n
if lt r 0
ret -3
end
ret r
end
note Input is one binary NUL byte. Output is the exact three bytes 4f 4b 0a.
fn main to int
b = new uchar 4096 0
outbuf = new uchar 8192 0
r = usread 1 b 0 1
if ne r 1
exit 21
end
if ne get b 0 0
exit 22
end
r = usread 1 b 0 1
if ne r 0
exit 23
end
put outbuf 0 79
put outbuf 1 75
put outbuf 2 10
r = uswrite 2 outbuf 0 3
if ne r 3
exit 24
end
ret 0
end
