# STEP4_gfx_ring.bench -- CP soft-reset, microcode load, ring test.
# Sources: gca/gfx_8_0_d.h MIT (C) 2016 AMD; gfx_v8_0.c.

# --- Soft reset CP and RLC ---
r32 BAR5+0x205C   # mmGRBM_SOFT_RESET (0x0817*4=0x205C) -- read before reset
w32 BAR5+0x205C 0x00010005   # SOFT_RESET_CP | SOFT_RESET_RLC | SOFT_RESET_GFX
# wait 1 ms
w32 BAR5+0x205C 0x00000000   # release reset

# --- Load RLC microcode ---
# (requires polaris11_rlc.bin content as dwords; fetch with fetch_gpu_ucode.sh)
w32 BAR5+0xC400 0x00000000   # mmRLC_GPM_UCODE_ADDR (0x3100*4=0xC400) = 0
# w32 BAR5+0xC404 <dword_N>  # mmRLC_GPM_UCODE_DATA (0x3101*4=0xC404), repeat N times

# --- Load PFP microcode ---
w32 BAR5+0x8540 0x00000000   # mmCP_PFP_UCODE_ADDR (0x2150*4=0x8540) = 0
# w32 BAR5+0x8544 <dword_N>  # mmCP_PFP_UCODE_DATA (0x2151*4=0x8544), repeat N times

# --- Enable RLC ---
w32 BAR5+0xC340 0x00000001   # mmRLC_CNTL (0x30d0*4=0xC340) = RLC_ENABLE

# --- Configure GFX ring 0 ---
# (ring_pa = physical address of 16KiB ring buffer below 4GiB)
# w32 BAR5+0x82FC <ring_pa >> 8>    # mmCP_RB0_BASE (0x20BF...)
# actually 0x20c5*4=0x8314:
# w32 BAR5+0x8314 <ring_pa >> 8>    # mmCP_RB0_BASE
# w32 BAR5+0x8318 <ring_pa >> 40>   # mmCP_RB0_BASE_HI
w32 BAR5+0x8304 0x0000000B   # mmCP_RB0_CNTL (0x20c1*4=0x8304) = BLKSZ=11 (4096 dwords)
# w32 BAR5+0x82FC <rptr_pa & 0xffffffff>  # mmCP_RB0_RPTR_ADDR
w32 BAR5+0x830C 0x00000000   # mmCP_RB0_WPTR (0x20c3*4=0x830C) = 0 (reset)

# --- Wait for CP to be idle ---
poll BAR5+0x390   # mmCP_STAT (0x00e4*4=0x390) bit 0 (PFP_BUSY) = 0
poll BAR5+0x390 0x00000001 0x00000000 5000   # wait up to 5s

# --- Submit NOP + WRITE_DATA fence (ring dwords, then advance WPTR) ---
# (ring content: see PM4 packet format in amd_ucode.c)
# w32 BAR5+0x830C 6   # mmCP_RB0_WPTR = 6 (NOP + WRITE_DATA = 6 dwords)
# poll <fence_va> 0xFFFFFFFF <seq> 5000  # wait for fence to land in memory
