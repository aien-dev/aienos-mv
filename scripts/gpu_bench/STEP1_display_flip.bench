# STEP1_display_flip.bench -- DCE 11.2 page flip, console form (ck_gpu_bench, feat/imac-gpu-bench).
# Indices are BAR5 DWORD indices (byte offset / 4); the byte offset is in each comment.
# Register numbers: native/kernel/gpu/amd_gpu_regs.h (dce_11_2_d.h).
#
# WRITE ALLOWLIST: the writes below (0x5045-0x5048) are NOT inside the console's
# current allowlist (0x4800-0x4900, 0x4A00-0x4C00). Run needs this entry added to the
# console allowlist first: 0x5040-0x5050 (DCE 11.2 GRPH primary surface, controller 0).
# scripts/gpu_bench/check_bench.sh reports them as NEEDS-ALLOWLIST until then.

# Confirm CRTC 0 and the current scanout
# mmCRTC_STATUS, byte 0x18138; bit 0 = in vblank
bar5_read 0x604e
# mmGRPH_PRIMARY_SURFACE_ADDRESS, byte 0x14114 (front buffer PA lo)
bar5_read 0x5045
# mmGRPH_PRIMARY_SURFACE_ADDRESS_HIGH, byte 0x14118
bar5_read 0x5046
# mmGRPH_FLIP_CONTROL, byte 0x1411C
bar5_read 0x5047
# mmGRPH_UPDATE, byte 0x14120 (lock bits)
bar5_read 0x5048

# Program the back buffer flip (back buffer = BAR0 + 0x2400000; example BAR0 0xc0000000 -> 0xc2400000)
# GRPH_UPDATE = GRPH_SURFACE_UPDATE_LOCK
bar5_write 0x5048 0x1
# GRPH_FLIP_CONTROL = flip at next vsync
bar5_write 0x5047 0x1
# GRPH_PRIMARY_SURFACE_ADDRESS_HIGH (bits 39:32)
bar5_write 0x5046 0x0
# GRPH_PRIMARY_SURFACE_ADDRESS = back buffer
bar5_write 0x5045 0xc2400000
# GRPH_UPDATE = unlock
bar5_write 0x5048 0x0

# Wait for the flip to land (GRPH_SURFACE_UPDATE_PENDING, bit 1, clears)
bar5_poll 0x5048 0x2 0x0 50

# Read back
# should read 0xc2400000
bar5_read 0x5045
# should read 0x0
bar5_read 0x5046
