# STEP2_gmc_read.bench -- Read GMC 8 memory controller state.
# Format: r32 BAR5+offset
# Sources: gmc/gmc_8_1_d.h MIT (C) 2016 AMD.

# MC_VM_FB_LOCATION (0x0009*4=0x24) -- VRAM start/end in 16-MiB units
# bits[15:0]=FB_START (VRAM PA = FB_START << 24)
# bits[31:16]=FB_TOP (last 16-MiB chunk)
r32 BAR5+0x24    # mmMC_VM_FB_LOCATION -- decode: FB_START*16MiB = VRAM PA

# MC_VM_SYSTEM_APERTURE_LOW_ADDR (0x000e*4=0x38) -- system RAM window lo (PA>>12)
r32 BAR5+0x38    # mmMC_VM_SYSTEM_APERTURE_LOW_ADDR

# MC_VM_SYSTEM_APERTURE_HIGH_ADDR (0x000f*4=0x3C)
r32 BAR5+0x3C    # mmMC_VM_SYSTEM_APERTURE_HIGH_ADDR

# AGP window (GART address range)
r32 BAR5+0x2C    # mmMC_VM_AGP_BOT (0x000c*4=0x30) actually 0x30
r32 BAR5+0x2C    # mmMC_VM_AGP_TOP (0x000b*4=0x2C)

# VM context 0 page table base
r32 BAR5+0x54C   # mmVM_CONTEXT0_PAGE_TABLE_BASE_ADDR (0x0153*4=0x54C)
